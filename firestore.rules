rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "kidace707@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    // ===============================================================
    // User Profile & Core Data
    // ===============================================================
    match /artifacts/{appId}/users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Nested subcollection support (e.g., profile/healthkit_sync_state)
    match /artifacts/{appId}/users/{userId}/{sub1}/{doc1}/{sub2}/{doc2} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // Weekly Summaries (top-level collection, filtered by userEmail)
    // ===============================================================
    match /weeklySummaries/{summaryId} {
      allow read: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
      allow create: if isAuthenticated() && request.resource.data.userEmail == request.auth.token.email;
      allow update, delete: if isAuthenticated() && resource.data.userEmail == request.auth.token.email;
    }
  }
}
